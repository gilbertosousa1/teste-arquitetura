      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "lancamentos.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "lancamentos.exchange",
      "vhost": "/",
      "destination": "lancamentos.queue",
      "destination_type": "queue",
      "routing_key": "lancamento.criado",
      "arguments": {}
    }
  ]
}
