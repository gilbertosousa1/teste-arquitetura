              <mxPoint x="110" y="448" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="IwuBleCYOb-_tW-l9HSz-65" parent="OF1-IOqoKPLwYHfCn3-g-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;Para garantir a segurança da informação todas as partes do sistema foram separadas em duas &lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;VLANS&lt;/b&gt;&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Internas &lt;/b&gt;&lt;i&gt;&lt;b&gt;(Quadros com fundo Vermelho):&lt;/b&gt;&amp;nbsp;Redes&amp;nbsp;&lt;/i&gt;responsáveis por armazenar os artefatos de sua responsabilidade e sua comunicação estará liberada apenas entre os &lt;b&gt;IPS &lt;/b&gt;e &lt;b&gt;Portas necessárias &lt;/b&gt;para a comunicação entre as&amp;nbsp; Aplicações.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Externas&amp;nbsp;&lt;/b&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;(Quadros com fundo Verde): &lt;/b&gt;Redes públicas responsáveis por servir as aplicações de FrontEnd para os usuários finais.&amp;nbsp;&lt;br&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Infraestrutura&lt;/b&gt;&lt;/font&gt;:&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;b&gt;Palo Alto: &lt;/b&gt;FireWall responsável por efetuar as liberações de acesso entre as aplicações&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;b&gt;Kubernates: &lt;/b&gt;Gerenciador de Pods responsável por efetuar o AutoScale das execuções das imagens Docker para garantir a alta disponibilidade das aplicações.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-weight: 700; text-align: center; text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;citrix waf&lt;/span&gt;&lt;b&gt;:&amp;nbsp;&lt;/b&gt;FireWall responsável pela liberação das portas Web e o Balance de requisições fazendo a distribuição pacotes entre os Pods Ativos das aplicações.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-weight: 700; text-align: center; text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Docker&lt;/span&gt;&lt;b&gt;: &lt;/b&gt;Toda infraestrutura de aplicações serão distribuidas em imagens Docker facilitando a distribuição, podendo ser executadas por qualquer gerenciador de Imagens Docker, seja Cloud ou Onpremisse.&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;.Net 8&lt;/span&gt;: &lt;/b&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Técnologia de desenvolvimento das aplicações.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; text-align: center;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;RabitMQ&lt;/span&gt;:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; text-align: center;&quot;&gt;Gerenciador de filas de eventos responsável por armazenar as mensagens que serão usadas para a integração Assincrona entre os sistemas de baixo acoplamento.&lt;/span&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; text-align: center;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="1367" x="-766" y="841" as="geometry" />
        </mxCell>
